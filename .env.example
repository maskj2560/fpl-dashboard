# Kopier til .env og fyll inn. Alle variabler unntatt PORT er valgfrie,
# men /lag, /liga, /live og deler av /brief krever FPL_TEAM_ID.

# Port serveren lytter på
PORT=3000

# Din FPL team-ID. Finn den ved å logge inn på fantasy.premierleague.com,
# gå til «Points» — tallet i URL-en er ID-en: /entry/DIN_ID/event/1
FPL_TEAM_ID=

# Kommaseparerte klassiske miniliga-ID-er. Tomt = hentes automatisk fra
# laget ditt (globale gigaligaer filtreres bort).
LEAGUE_IDS=

# Kommaseparerte RSS-URL-er for /nyheter. Tomt = fornuftige defaults
# (BBC Sport Football, Sky Sports Football).
NEWS_FEEDS=

# Claude API-nøkkel — valgfri. Uten nøkkel fungerer alt, men AI-oppsummering,
# AI-brief og transfer-rådgiver er inaktive.
ANTHROPIC_API_KEY=

# AI-modell. Default claude-sonnet-5 (best balanse kvalitet/pris).
# Billig-alternativ: claude-haiku-4-5
AI_MODEL=claude-sonnet-5

# Discord-webhook for auto-brief før deadline — valgfri.
DISCORD_WEBHOOK_URL=

# Hvor mange timer før deadline auto-briefen sendes.
BRIEF_HOURS_BEFORE_DEADLINE=24

# Mappe for tilstand som skal overleve omstart (auto-briefens sendt-markør).
# I prod: et persistent volum montert på /app/data.
# DATA_DIR=data

# Tidssone for visning av deadlines og kamptider.
TZ=Europe/Oslo
