<%
  // AI-tekst er utrygt innhold: escape først, gjør **fet** om til <strong> etterpå.
  function esc(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
  function bold(text) {
    return esc(text).replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
  }
%>
<section class="page-head">
  <h1>Rundebrief</h1>
  <% if (brief.gameweek) { %>
    <p class="dim"><span class="gw-badge"><%= brief.gameweek.name %></span> · Deadline <strong><%= brief.gameweek.deadlineFormatted %></strong></p>
  <% } %>
</section>

<% if (typeof aiBrief !== 'undefined' && aiBrief?.text) { %>
  <section class="card card-wide card-ai">
    <h2>
      <span class="h2-title"><span class="ai-badge">AI</span> Rundebrief</span>
      <span class="dim">generert <%= new Date(aiBrief.generatedAt).toLocaleTimeString('nb-NO', { hour: '2-digit', minute: '2-digit' }) %></span>
    </h2>
    <% for (const line of aiBrief.text.split('\n')) { %>
      <% if (/^#{1,3}\s/.test(line)) { %>
        <h3 class="sub-head"><%- bold(line.replace(/^#{1,3}\s*/, '')) %></h3>
      <% } else if (line.trim()) { %>
        <p><%- bold(line.replace(/^[-*]\s*/, '• ')) %></p>
      <% } %>
    <% } %>
  </section>
<% } %>

<div class="grid">
  <section class="card">
    <h2>Skader og suspensjoner (høyt eide)</h2>
    <% if (brief.injuries.length === 0) { %><p class="empty">Ingen viktige skader meldt.</p><% } else { %>
      <ul class="rec-list"><% for (const i of brief.injuries) { %>
        <li><strong><%= i.name %></strong> <%- include('partials/club-badge', { team: { short_name: i.team, code: i.teamCode } }) %> <span class="dim">eid <%= i.ownership %> %</span><ul class="reasons"><li><%= i.news %></li></ul></li>
      <% } %></ul>
    <% } %>
  </section>
  <section class="card">
    <h2>Kapteinskandidater globalt</h2>
    <ol class="rec-list"><% for (const c of brief.captains) { %>
      <li><a href="/spillere?sok=<%= encodeURIComponent(c.name) %>"><strong><%= c.name %></strong></a> <%- include('partials/club-badge', { team: { short_name: c.team, code: c.teamCode } }) %> <span class="dim">form <%= c.form %> · eid <%= c.ownership %> %<% if (c.avgFdr != null) { %> · FDR <%= c.avgFdr.toFixed(1) %><% } %></span></li>
    <% } %></ol>
    <p class="hint">FDR = FPLs vanskelighetsgrad for kampprogrammet, 1 (lett) til 5 (vanskelig).</p>
  </section>
</div>

<section class="card card-wide">
  <h2>Kamper i runden</h2>
  <% if (brief.fixturesByDay.length === 0) { %><p class="empty">Ingen kamper funnet i denne runden ennå. Kampprogrammet legges ut av FPL noen dager før deadline.</p><% } %>
  <div class="grid">
    <% for (const d of brief.fixturesByDay) { %>
      <div>
        <h3 class="sub-head"><%= d.day %></h3>
        <ul class="fixture-list">
          <% for (const m of d.matches) { %><li class="fixture-row"><span class="num fixture-time"><%= m.kickoff %></span> <%- include('partials/club-badge', { team: { short_name: m.home, code: m.homeCode } }) %> – <%- include('partials/club-badge', { team: { short_name: m.away, code: m.awayCode } }) %></li><% } %>
        </ul>
      </div>
    <% } %>
  </div>
</section>

<% if (brief.mine) { %>
  <div class="grid">
    <section class="card">
      <h2>Mine kapteinsvalg</h2>
      <% if (brief.mine.captains.length === 0) { %><p class="empty">Ingen kandidater denne runden.</p><% } else { %>
      <ol class="rec-list"><% for (const c of brief.mine.captains) { %>
        <li><strong><%= c.player.web_name %></strong><ul class="reasons"><% for (const r of c.reasons) { %><li><%= r %></li><% } %></ul></li>
      <% } %></ol>
      <% } %>
    </section>
    <section class="card">
      <h2>Mine transferkandidater</h2>
      <% if (brief.mine.transfers.length === 0) { %><p class="empty">Ingen åpenbare bytter.</p><% } else { %>
        <% for (const t of brief.mine.transfers) { %>
          <p class="transfer-out"><strong>Ut:</strong> <%= t.out.player.web_name %><% if (t.inn.length) { %> · <strong>Inn:</strong> <%= t.inn.map((k) => k.player.web_name).join(', ') %><% } %></p>
        <% } %>
      <% } %>
    </section>
  </div>
<% } else { %>
  <section class="card"><p class="empty">Sett <code>FPL_TEAM_ID</code> for å få kaptein- og transferforslag basert på din egen tropp.</p></section>
<% } %>
