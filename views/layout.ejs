<!doctype html>
<html lang="nb">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · FPL-dashboard</title>
  <link rel="icon" href='data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">⚽</text></svg>'>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="topbar">
    <a class="wordmark" href="/">FPL<span>dashboard</span></a>
    <nav aria-label="Hovedmeny">
      <a href="/" <%= path === '/' ? 'aria-current="page"' : '' %>>Dashboard</a>
      <a href="/spillere" <%= path.startsWith('/spillere') ? 'aria-current="page"' : '' %>>Spillere</a>
      <a href="/lag" <%= path.startsWith('/lag') ? 'aria-current="page"' : '' %>>Lag</a>
    </nav>
  </header>

  <% if (gameUpdating) { %>
    <div class="banner" role="status">
      FPL oppdaterer spillet akkurat nå — viser sist kjente data.
    </div>
  <% } %>

  <main>
    <%- body %>
  </main>

  <footer>
    <p>Uoffisielt verktøy. Data fra Fantasy Premier League.</p>
  </footer>

  <script src="/app.js" defer></script>
</body>
</html>
