<!doctype html>
<html lang="nb">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · FPL-dashboard</title>
  <link rel="icon" href='data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">⚽</text></svg>'>
  <script>
    // Tema før første paint: lagret valg vinner, ellers systemets. Må ligge
    // inline foran stilarket — et eksternt script gir et blaff i feil tema.
    // Speiler resolveTheme() i app.js. Uten JS: mørkt (CSS-basen).
    (function () {
      var t = null;
      try { t = localStorage.getItem('fpl-theme'); } catch (e) { /* privat modus */ }
      if (t !== 'light' && t !== 'dark') {
        t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      }
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
  <!-- Fonten er uendret innhold: ?v bumpes for hånd, og MÅ være identisk med
       @font-face-URL-en i style.css, ellers lastes fonten to ganger. -->
  <link rel="preload" href="/fonts/archivo-var.woff2?v=1" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
</head>
<body>
  <header class="topbar">
    <a class="wordmark" href="/">FPL<span>dashboard</span></a>
    <!-- aria-current skrives uescapet: escaping gjør anførselstegnene til
         &#34;, og da matcher attributtet hverken CSS-en eller skjermlesere.
         Verdiene er faste strenger, ikke brukerinnhold. -->
    <nav aria-label="Hovedmeny">
      <a href="/" <%- path === '/' ? 'aria-current="page"' : '' %>>Dashbord</a>
      <a href="/spillere" <%- path.startsWith('/spillere') ? 'aria-current="page"' : '' %>>Spillere</a>
      <a href="/lag" <%- path === '/lag' || path.startsWith('/lag/') ? 'aria-current="page"' : '' %>>Lag</a>
      <a href="/overganger" <%- path.startsWith('/overganger') ? 'aria-current="page"' : '' %>>Overganger</a>
      <a href="/liga" <%- path.startsWith('/liga') ? 'aria-current="page"' : '' %>>Liga</a>
      <a href="/brief" <%- path.startsWith('/brief') ? 'aria-current="page"' : '' %>>Brief</a>
      <a href="/live" <%- path.startsWith('/live') ? 'aria-current="page"' : '' %>>Live</a>
      <a href="/nyheter" <%- path.startsWith('/nyheter') ? 'aria-current="page"' : '' %>>Nyheter</a>
    </nav>
    <%- include('partials/theme-toggle') %>
  </header>

  <% if (gameUpdating) { %>
    <div class="banner" role="status">
      FPL oppdaterer spillet akkurat nå — viser sist kjente data.
    </div>
  <% } %>

  <main>
    <%- body %>
  </main>

  <footer>
    <p>Uoffisielt verktøy. Data fra Fantasy Premier League.</p>
    <p class="credit">Klubbmerker og drakter tilhører respektive klubber og Premier League.</p>
    <p class="version">v<%= version %> · sist oppdatert <%= startedAt %></p>
  </footer>

  <script src="/app.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
