<% if (deadlineEvent) { %>
  <section class="hero">
    <h1 class="sr-only">Neste deadline — <%= deadlineEvent.name %></h1>
    <p class="eyebrow"><span class="gw-badge"><%= deadlineEvent.name %></span> Neste deadline</p>
    <p class="hero-date"><%= formatDateTime(deadlineEvent.deadline_time) %></p>
    <%# role=timer: aria-live er implisitt off, så sekundene leses aldri opp. %>
    <div class="countdown" role="timer" data-deadline="<%= deadlineEvent.deadline_time %>">
      <div class="unit"><span class="val" data-unit="d">–</span><span class="lbl">dager</span></div>
      <div class="unit"><span class="val" data-unit="h">–</span><span class="lbl">timer</span></div>
      <div class="unit"><span class="val" data-unit="m">–</span><span class="lbl">min</span></div>
      <div class="unit"><span class="val" data-unit="s">–</span><span class="lbl">sek</span></div>
    </div>
  </section>
<% } else { %>
  <section class="hero">
    <h1>Ingen kommende deadline</h1>
    <p class="hero-date">Sesongen er ferdig eller ikke i gang ennå. Nedtellingen kommer tilbake så snart FPL åpner neste runde.</p>
  </section>
<% } %>

<div class="grid grid-quad">
  <section class="card">
    <h2><span class="h2-title">Ukens flagg</span><span class="dim"><%= flagged.length %></span></h2>
    <% if (flagged.length === 0) { %>
      <p class="empty">Ingen spillere er flagget nå. Status endrer seg ofte etter pressekonferansene — sjekk igjen nærmere deadline.</p>
    <% } else { %>
      <div class="table-scroll">
        <table class="data"><caption class="sr-only">Ukens flagg</caption>
          <thead>
            <tr><th>Spiller</th><th>Lag</th><th class="num">Eid</th><th>Status</th></tr>
          </thead>
          <tbody>
            <% for (const p of flagged) { %>
              <tr>
                <td>
                  <strong><%= p.web_name %></strong>
                  <% if (p.news) { %><span class="news"><%= translateFplNews(p.news) %></span><% } %>
                </td>
                <td><%- include('partials/club-badge', { team: teamsById.get(p.team) }) %></td>
                <td class="num"><%= p.selected_by_percent %> %</td>
                <td>
                  <span class="status status-<%= p.status %>"><%= STATUS_LABELS[p.status] ?? p.status %></span>
                  <% if (p.chance_of_playing_next_round != null && p.status !== 'a') { %>
                    <span class="chance"><%= p.chance_of_playing_next_round %> %</span>
                  <% } %>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <p class="hint">Flagg er FPLs egen tilgjengelighetsstatus. Prosenten er sjansen for spill i neste runde der FPL oppgir den.</p>
    <% } %>
  </section>

  <section class="card">
    <h2><span class="h2-title">Toppform</span><span class="dim"><%= inForm.length %></span></h2>
    <% if (inForm.length === 0) { %>
      <p class="empty">Formtallene nullstilles mellom sesongene. Toppformlisten fylles så snart den første runden er spilt.</p>
    <% } else { %>
      <div class="table-scroll">
        <table class="data"><caption class="sr-only">Toppform</caption>
          <thead>
            <tr><th>Spiller</th><th>Lag</th><th>Pos</th><th class="num">Form</th><th class="num">Poeng</th></tr>
          </thead>
          <tbody>
            <% for (const p of inForm) { %>
              <tr>
                <td><a href="/spillere?sok=<%= encodeURIComponent(p.web_name) %>"><strong><%= p.web_name %></strong></a></td>
                <td><%- include('partials/club-badge', { team: teamsById.get(p.team) }) %></td>
                <td><%= POSITIONS_SHORT[p.element_type] %></td>
                <td class="num accent"><%= p.form %></td>
                <td class="num"><%= p.total_points %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <section class="card">
    <h2><span class="h2-title">Mest kjøpt denne runden</span><span class="dim"><%= boughtMost.length %></span></h2>
    <% if (boughtMost.length === 0) { %>
      <p class="empty">Ingen overganger er registrert i denne runden ennå. Listen fylles etter hvert som managerne begynner å bytte.</p>
    <% } else { %>
      <div class="table-scroll">
        <table class="data"><caption class="sr-only">Mest kjøpt denne runden</caption>
          <thead>
            <tr><th>Spiller</th><th class="num">Pris</th><th class="num">Inn</th></tr>
          </thead>
          <tbody>
            <% for (const p of boughtMost) { %>
              <tr>
                <td><a href="/spillere?sok=<%= encodeURIComponent(p.web_name) %>"><strong><%= p.web_name %></strong></a> <%- include('partials/club-badge', { team: teamsById.get(p.team) }) %></td>
                <td class="num"><%= formatPrice(p.now_cost) %></td>
                <td class="num accent">+<%= formatNumber(p.transfers_in_event) %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <section class="card">
    <h2><span class="h2-title">Mest solgt denne runden</span><span class="dim"><%= soldMost.length %></span></h2>
    <% if (soldMost.length === 0) { %>
      <p class="empty">Ingen overganger er registrert i denne runden ennå. Listen fylles etter hvert som managerne begynner å bytte.</p>
    <% } else { %>
      <div class="table-scroll">
        <table class="data"><caption class="sr-only">Mest solgt denne runden</caption>
          <thead>
            <tr><th>Spiller</th><th class="num">Pris</th><th class="num">Ut</th></tr>
          </thead>
          <tbody>
            <% for (const p of soldMost) { %>
              <tr>
                <td><a href="/spillere?sok=<%= encodeURIComponent(p.web_name) %>"><strong><%= p.web_name %></strong></a> <%- include('partials/club-badge', { team: teamsById.get(p.team) }) %></td>
                <td class="num"><%= formatPrice(p.now_cost) %></td>
                <td class="num negative">−<%= formatNumber(p.transfers_out_event) %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</div>

<section class="card card-wide">
  <h2>Fixture-vanskelighet — neste <%= matrix.gameweeks.length %> runder</h2>
  <p class="legend">
    <span class="fdr fdr-1">1 lett</span>
    <span class="fdr fdr-2">2</span>
    <span class="fdr fdr-3">3</span>
    <span class="fdr fdr-4">4</span>
    <span class="fdr fdr-5">5 vanskelig</span>
  </p>
  <div class="table-scroll">
    <table class="data fdr-table"><caption class="sr-only">Fixture-vanskelighet per lag og runde</caption>
      <thead>
        <tr>
          <th>Lag</th>
          <% for (const gw of matrix.gameweeks) { %><th class="num">GW<%= gw %></th><% } %>
          <th class="num">Snitt</th>
        </tr>
      </thead>
      <tbody>
        <% for (const row of matrix.rows) { %>
          <tr>
            <td class="fdr-team"><%- include('partials/club-badge', { team: row.team, size: 'md' }) %> <span class="dim team-name-full"><%= row.team.name %></span></td>
            <% for (const cell of row.cells) { %>
              <td class="fdr-cell">
                <% if (cell.length === 0) { %>
                  <span class="fdr fdr-blank">–</span>
                <% } else { %>
                  <% for (const match of cell) { %>
                    <span class="fdr fdr-<%= match.difficulty %>" title="<%= match.home ? 'Hjemme' : 'Borte' %> mot <%= match.opponent %>">
                      <%= match.home ? match.opponent : match.opponent.toLowerCase() %>
                    </span>
                  <% } %>
                <% } %>
              </td>
            <% } %>
            <td class="num dim"><%= row.avgDifficulty == null ? '–' : row.avgDifficulty.toFixed(1) %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <p class="hint">STORE bokstaver = hjemmekamp, små = bortekamp.</p>
</section>

<% if (newsPoints && newsPoints.length > 0) { %>
  <section class="card card-wide card-ai">
    <h2><span class="h2-title"><span class="ai-badge">AI</span> Siste FPL-nytt</span></h2>
    <ul class="rec-list"><% for (const p of newsPoints) { %><li><%= p.replace(/\*\*/g, '') %></li><% } %></ul>
    <p class="hint"><a href="/nyheter">Alle nyheter →</a></p>
  </section>
<% } %>
