<section class="page-head">
  <h1>Miniligaer</h1>
  <% if (leagues.some((l) => l.standings.results.length > 0)) { %>
    <p class="dim">Klikk på et lag i tabellen for å sammenligne tropper (differensialer).</p>
  <% } %>
</section>

<% if (leagues.length === 0) { %>
  <section class="card"><p class="empty">Fant ingen private miniligaer. Ligaene hentes automatisk fra laget ditt — mangler noen, sett <code>LEAGUE_IDS</code> i miljøvariablene.</p></section>
<% } %>

<div class="grid">
  <% for (const l of leagues) { %>
    <section class="card">
      <h2><%= l.league.name %></h2>
      <% if (l.standings.results.length === 0) { %>
        <p class="empty">
          Ligatabellen er tom fram til første runde er spilt. Den fylles så snart
          runden er ferdig — <a href="/">se nedtellingen på dashbordet</a>.
        </p>
      <% } else { %>
      <div class="table-scroll">
        <table class="data">
          <thead><tr><th class="num">#</th><th>Lag</th><th class="num">GW</th><th class="num">Totalt</th></tr></thead>
          <tbody>
            <% for (const r of l.standings.results) { %>
              <tr class="<%= [r.entry === myEntry ? 'row-me' : '', r.entry === rivalEntry ? 'row-rival' : ''].join(' ').trim() %>"<% if (r.entry !== myEntry) { %> data-href="/liga?rival=<%= r.entry %>"<% } %>>
                <td class="num">
                  <%= r.rank %>
                  <% if (r.last_rank && r.rank < r.last_rank) { %>
                    <span class="rank-up" aria-label="opp <%= r.last_rank - r.rank %> <%= r.last_rank - r.rank === 1 ? 'plass' : 'plasser' %>">▲</span>
                  <% } else if (r.last_rank && r.rank > r.last_rank) { %>
                    <span class="rank-down" aria-label="ned <%= r.rank - r.last_rank %> <%= r.rank - r.last_rank === 1 ? 'plass' : 'plasser' %>">▼</span>
                  <% } else { %>
                    <span class="rank-same" aria-label="uendret plassering">–</span>
                  <% } %>
                </td>
                <td>
                  <% if (r.entry === myEntry) { %>
                    <strong><%= r.entry_name %></strong> <span class="dim">(meg)</span>
                  <% } else { %>
                    <a href="/liga?rival=<%= r.entry %>"><%= r.entry_name %></a> <span class="dim"><%= r.player_name %></span>
                  <% } %>
                </td>
                <td class="num"><%= r.event_total %></td>
                <td class="num"><strong><%= formatNumber(r.total) %></strong></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% } %>
    </section>
  <% } %>
</div>

<% if (report && report.text) { %>
  <%
    // AI-tekst er utrygt innhold: escape først, gjør **fet** om til <strong>.
    function escAi(s) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    function boldAi(text) {
      return escAi(text).replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    }
  %>
  <section class="card card-wide <%= report.source === 'ai' ? 'card-ai' : '' %>">
    <h2><span class="h2-title"><% if (report.source === 'ai') { %><span class="ai-badge">AI</span> <% } %>Rundens rapport</span> <span class="dim">Runde <%= report.lastReportedEvent %></span></h2>
    <% for (const line of report.text.split('\n').filter((l) => l.trim())) { %>
      <p><%- boldAi(line) %></p>
    <% } %>
    <% if (report.generatedAt) { %><p class="hint">Skrevet <%= formatDateTime(report.generatedAt) %></p><% } %>
  </section>
<% } %>

<% /* Radar-spillere har {name, teamCode, teamShort, eventPoints} — badge bygges inline. */ %>
<% const radarBadge = (p) => ({ team: { short_name: p.teamShort, code: p.teamCode, name: p.teamShort }, showName: false }); %>

<% if (insights && insights.rival) { const rv = insights.rival; %>
  <section class="card card-wide">
    <h2>Rival-radar <span class="dim">deg mot <%= rv.rival.entryName %></span></h2>
    <form method="get" action="/liga" id="rival-form" class="rival-form">
      <label for="rival-select" class="dim">Rival:</label>
      <select name="rival" id="rival-select">
        <% for (const r of insights.results) { if (r.entry === myEntry) continue; %>
          <option value="<%= r.entry %>"<%= r.entry === insights.rivalEntry ? ' selected' : '' %>><%= r.entry_name %> — <%= r.player_name %></option>
        <% } %>
      </select>
      <noscript><button type="submit" class="btn">Bytt</button></noscript>
    </form>

    <% const leadTotal = (rv.me.total ?? 0) - (rv.rival.total ?? 0); %>
    <% const leadEvent = (rv.me.eventTotal ?? 0) - (rv.rival.eventTotal ?? 0); %>
    <div class="stat-strip">
      <div class="stat"><span class="stat-val <%= leadTotal > 0 ? 'accent' : (leadTotal < 0 ? 'negative' : '') %>"><%= formatSigned(leadTotal) %></span><span class="stat-lbl">Avstand totalt</span></div>
      <div class="stat"><span class="stat-val <%= leadEvent > 0 ? 'accent' : (leadEvent < 0 ? 'negative' : '') %>"><%= formatSigned(leadEvent) %></span><span class="stat-lbl">Siste runde</span></div>
      <div class="stat"><span class="stat-val"><%= rv.captains.mine ? rv.captains.mine.name : '–' %><% if (rv.captains.mine && rv.captains.mine.tc) { %> <span class="status">TC</span><% } %></span><span class="stat-lbl">Min kaptein<%= rv.captains.mine ? ` · ${rv.captains.mine.eventPoints} p` : '' %></span></div>
      <div class="stat"><span class="stat-val"><%= rv.captains.rival ? rv.captains.rival.name : '–' %><% if (rv.captains.rival && rv.captains.rival.tc) { %> <span class="status">TC</span><% } %></span><span class="stat-lbl">Rivalens kaptein<%= rv.captains.rival ? ` · ${rv.captains.rival.eventPoints} p` : '' %></span></div>
    </div>

    <h3 class="sub-head">Differensialer</h3>
    <div class="grid">
      <div>
        <h4 class="sub-head dim">De har — jeg mangler</h4>
        <% if (rv.diff.theirs.length === 0) { %><p class="empty">Ingen.</p><% } else { %>
        <div class="table-scroll"><table class="data">
          <thead><tr><th>Spiller</th><th class="num">Poeng</th></tr></thead>
          <tbody><% for (const p of rv.diff.theirs) { %>
            <tr><td><%- include('partials/club-badge', radarBadge(p)) %> <strong><%= p.name %></strong></td><td class="num"><%= p.eventPoints %></td></tr>
          <% } %></tbody>
        </table></div>
        <% } %>
      </div>
      <div>
        <h4 class="sub-head dim">Jeg har — de mangler</h4>
        <% if (rv.diff.mine.length === 0) { %><p class="empty">Ingen.</p><% } else { %>
        <div class="table-scroll"><table class="data">
          <thead><tr><th>Spiller</th><th class="num">Poeng</th></tr></thead>
          <tbody><% for (const p of rv.diff.mine) { %>
            <tr><td><%- include('partials/club-badge', radarBadge(p)) %> <strong><%= p.name %></strong></td><td class="num"><%= p.eventPoints %></td></tr>
          <% } %></tbody>
        </table></div>
        <% } %>
      </div>
    </div>

    <h3 class="sub-head">Felles spillere</h3>
    <% if (rv.shared.length === 0) { %>
      <p class="empty">Ingen felles spillere denne runden.</p>
    <% } else { %>
      <ul class="shared-players">
        <% for (const p of rv.shared) { %>
          <li><%- include('partials/club-badge', radarBadge(p)) %> <%= p.name %> <span class="dim"><%= p.eventPoints %> p</span></li>
        <% } %>
      </ul>
    <% } %>
  </section>
<% } %>

<% if (insights && insights.captainLeague) { const cl = insights.captainLeague; %>
  <section class="card card-wide">
    <h2>Kaptein-liga <span class="dim">Runde <%= cl.lastGw %></span></h2>
    <div class="table-scroll">
      <table class="data">
        <thead><tr><th>Manager</th><th>Kaptein</th><th class="num">Poeng</th><th class="num">Tapt mot optimal</th><th class="num">Sum poeng</th><th class="num">Sum tapt</th></tr></thead>
        <tbody>
          <% for (const r of cl.rows) { %>
            <tr class="<%= r.entry === myEntry ? 'row-me' : '' %>">
              <td><%= r.entryName %></td>
              <td><% if (r.last) { %><%- include('partials/club-badge', radarBadge(r.last)) %> <%= r.last.name %><% if (r.last.tc) { %> <span class="status">TC</span><% } %><% } else { %><span class="dim">–</span><% } %></td>
              <td class="num"><%= r.last ? r.last.points : '–' %></td>
              <td class="num <%= r.last && r.last.lost > 0 ? 'negative' : '' %>"><%= r.last ? (r.last.lost > 0 ? formatSigned(-r.last.lost) : '0') : '–' %></td>
              <td class="num"><strong><%= r.sum.points %></strong></td>
              <td class="num"><%= r.sum.lost > 0 ? formatSigned(-r.sum.lost) : '0' %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <p class="dim"><%= cl.capped ? `Sum over de siste ${cl.depth} ferdige rundene.` : 'Sum over hele sesongen.' %>
    Tapt mot optimal: beste spiller i start-XI minus kapteinen, i rå spillerpoeng.</p>
  </section>
<% } %>

<% if (insights && insights.graph) { const g = insights.graph; %>
  <% const seriesColor = (s) => s.me ? 'var(--accent)' : (s.rival ? 'var(--accent-2)' : 'var(--text-dim)'); %>
  <section class="card card-wide">
    <h2>Sesongutvikling <span class="dim">Runde <%= g.gwFirst %>–<%= g.gwLast %></span></h2>
    <svg class="rank-graph league-graph" viewBox="-8 -8 <%= g.width + 16 %> <%= g.height + 16 %>" preserveAspectRatio="none" role="img" aria-label="Ligaplassering per runde">
      <% for (const y of [0, g.height / 2, g.height]) { %>
        <line x1="0" y1="<%= y %>" x2="<%= g.width %>" y2="<%= y %>" stroke="var(--border)" stroke-width="1" vector-effect="non-scaling-stroke" />
      <% } %>
      <% for (const s of g.series) { if (!s.points) continue; %>
        <% if (g.single) { %>
          <circle cx="<%= s.points.split(',')[0] %>" cy="<%= s.points.split(',')[1] %>" r="4" fill="<%= seriesColor(s) %>" />
        <% } else { %>
          <polyline points="<%= s.points %>" fill="none" stroke="<%= seriesColor(s) %>" stroke-width="<%= s.me ? 2.5 : (s.rival ? 2 : 1) %>" vector-effect="non-scaling-stroke" stroke-linejoin="round" stroke-linecap="round" />
        <% } %>
      <% } %>
    </svg>
    <ul class="graph-legend">
      <% for (const s of [...g.series].reverse()) { %>
        <li><span class="legend-swatch" style="background: <%= seriesColor(s) %>"></span><%= s.name %><% if (s.me) { %> <span class="dim">(meg)</span><% } else if (s.rival) { %> <span class="dim">(rival)</span><% } %><% if (s.lastRank) { %> <span class="dim">· <%= s.lastRank %>.</span><% } %></li>
      <% } %>
    </ul>
    <p class="hint">Ligaplassering per runde — toppen er 1. plass.</p>
  </section>
<% } %>
