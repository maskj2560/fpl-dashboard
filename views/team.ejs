<section class="page-head">
  <h1><%= entry.name %></h1>
  <p class="dim"><%= entry.player_first_name %> <%= entry.player_last_name %><% if (gw) { %> · Runde <%= gw %><% } %><% if (squadView?.activeChip) { %> · Chip: <%= squadView.activeChip %><% } %></p>
</section>

<div class="stat-strip">
  <div class="stat"><span class="stat-val"><%= squadView ? squadView.entryHistory.points : '–' %></span><span class="stat-lbl">GW-poeng</span></div>
  <div class="stat"><span class="stat-val"><%= squadView ? formatNumber(entry.summary_overall_points) : '–' %></span><span class="stat-lbl">Totalt</span></div>
  <div class="stat"><span class="stat-val"><%= squadView ? formatNumber(entry.summary_overall_rank) : '–' %></span><span class="stat-lbl">Totalrangering</span></div>
  <div class="stat"><span class="stat-val"><%= squadView ? formatPrice(squadView.entryHistory.value - squadView.entryHistory.bank) : '–' %></span><span class="stat-lbl">Lagverdi (£m)</span></div>
  <div class="stat"><span class="stat-val"><%= squadView ? formatPrice(squadView.entryHistory.bank) : '–' %></span><span class="stat-lbl">Bank (£m)</span></div>
</div>

<% if (!squadView) { %>
  <section class="card">
    <p class="empty">
      Fant ingen lagoppstilling ennå. FPL gir ikke ut troppen din før den
      første deadlinen i sesongen har passert — se nedtellingen på
      <a href="/">dashbordet</a>. Da fylles denne siden av seg selv.
    </p>
  </section>
<% } else { %>
  <section class="card card-wide">
    <h2><span class="h2-title">Oppstilling</span><% if (squadView.activeChip) { %><span class="status">Chip: <%= squadView.activeChip %></span><% } %></h2>
    <div class="pitch">
      <% for (const line of [1, 2, 3, 4]) { %>
        <div class="pitch-row">
          <% for (const s of squadView.byLine[line]) { %>
            <div class="chip<%= s.pick.is_captain ? ' chip-captain' : '' %>">
              <%- include('partials/club-shirt', { team: teamsById.get(s.player.team), keeper: s.player.element_type === 1 }) %>
              <span class="chip-name"><%= s.player.web_name %><% if (s.pick.is_captain) { %> <b class="cap">C</b><% } else if (s.pick.is_vice_captain) { %> <b class="cap vice">V</b><% } %></span>
              <span class="chip-meta"><%= teamsById.get(s.player.team)?.short_name %> · <%= formatPrice(s.player.now_cost) %></span>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
    <div class="bench">
      <span class="bench-label">Benk</span>
      <% for (const s of squadView.bench) { %>
        <div class="chip chip-bench">
          <%- include('partials/club-shirt', { team: teamsById.get(s.player.team), keeper: s.player.element_type === 1 }) %>
          <span class="chip-name"><%= s.player.web_name %></span>
          <span class="chip-meta"><%= POSITIONS_SHORT[s.player.element_type] %> · <%= formatPrice(s.player.now_cost) %></span>
        </div>
      <% } %>
    </div>
  </section>
<% } %>

<% if (graph) { %>
  <section class="card card-wide">
    <h2>Totalrangering per runde</h2>
    <svg class="rank-graph" viewBox="-8 -8 616 156" preserveAspectRatio="none" role="img" aria-label="Rankutvikling">
      <defs>
        <linearGradient id="rank-fill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="var(--accent)" stop-opacity="0.22" />
          <stop offset="1" stop-color="var(--accent)" stop-opacity="0" />
        </linearGradient>
      </defs>
      <% for (const y of [0, 70, 140]) { %>
        <line x1="0" y1="<%= y %>" x2="600" y2="<%= y %>" stroke="var(--border)" stroke-width="1" vector-effect="non-scaling-stroke" />
      <% } %>
      <% if (graph.area) { %><polygon points="<%= graph.area %>" fill="url(#rank-fill)" /><% } %>
      <polyline points="<%= graph.points %>" fill="none" stroke="var(--accent)" stroke-width="2.5" vector-effect="non-scaling-stroke" stroke-linejoin="round" stroke-linecap="round" />
    </svg>
    <p class="hint">Best: <%= formatNumber(graph.min) %> · Nå: <%= formatNumber(graph.last) %> (lavere er bedre — toppen av grafen er best)</p>
  </section>
<% } %>

<% if (recommendations) { %>
  <h2 class="sub-head">Anbefalinger for Runde <%= fromGw %></h2>
  <div class="grid">
    <section class="card">
      <h2>Kapteinsvalg</h2>
      <% if (recommendations.captains.length === 0) { %>
        <p class="empty">Ingen aktuelle kapteiner — ingen i troppen er spilleklare.</p>
      <% } else { %>
        <% if (recommendations.captains[0].criterion === 'ep_next') { %>
          <p class="hint">Ingen formdata ennå — rangert på FPLs forventede poeng.</p>
        <% } %>
        <ol class="rec-list">
          <% for (const c of recommendations.captains) { %>
            <li>
              <strong><%= c.player.web_name %></strong> <%- include('partials/club-badge', { team: teamsById.get(c.player.team) }) %>
              <ul class="reasons"><% for (const r of c.reasons) { %><li><%= r %></li><% } %></ul>
            </li>
          <% } %>
        </ol>
      <% } %>
    </section>
    <section class="card">
      <h2>Vurder å selge</h2>
      <% if (recommendations.transfers.length === 0) { %>
        <p class="empty">Ingen åpenbare salgskandidater — troppen ser sunn ut.</p>
      <% } else { %>
        <% for (const t of recommendations.transfers) { %>
          <div class="transfer-block">
            <p class="transfer-out"><strong><%= t.out.player.web_name %></strong> <span class="dim">(<%= formatPrice(t.out.player.now_cost) %>)</span></p>
            <ul class="reasons"><% for (const r of t.out.reasons) { %><li><%= r %></li><% } %></ul>
            <% if (t.inn.length > 0) { %>
              <p class="dim">Erstattere innenfor budsjett:</p>
              <ul class="reasons">
                <% for (const k of t.inn) { %>
                  <li><strong><%= k.player.web_name %></strong> <%- include('partials/club-badge', { team: teamsById.get(k.player.team) }) %> · <%= formatPrice(k.player.now_cost) %> · form <%= k.player.form %></li>
                <% } %>
              </ul>
            <% } %>
          </div>
        <% } %>
      <% } %>
    </section>
  </div>

  <section class="card card-wide" id="ai-advice-box">
    <h2>AI-rådgiver</h2>
    <p class="dim">Sender troppen og analysen til Claude og får begrunnede råd. Svar caches i én time.</p>
    <button type="button" id="ai-advice-btn" class="btn-accent">Spør AI om råd</button>
    <div id="ai-advice-result" class="ai-result" hidden></div>
  </section>
<% } %>
