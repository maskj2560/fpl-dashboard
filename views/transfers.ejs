<section class="page-head">
  <h1>Overganger</h1>
  <p class="dim">Hva byttene dine var verdt: poengene spilleren du hentet
  faktisk fikk, minus poengene spilleren du solgte fikk, så lenge byttet var
  i effekt — rå spillerpoeng uten benk- og kapteinsvekting, minus
  poengstraff. Hvert bytte måles for seg.</p>
</section>

<% if (analysis.totals.count === 0) { %>
  <section class="card">
    <p class="empty">
      Ingen overganger registrert ennå. Din første overgang kan tidligst
      gjelde runde 2 — når du bytter en spiller, dukker regnskapet opp her:
      poeng inn mot poeng ut for hvert bytte, straff, og summen for sesongen.
    </p>
  </section>
<% } else { %>
  <% const played = analysis.rows.filter((r) => r.played); %>
  <div class="stat-strip">
    <div class="stat"><span class="stat-val <%= analysis.totals.netto > 0 ? 'accent' : (analysis.totals.netto < 0 ? 'negative' : '') %>"><%= played.length ? formatSigned(analysis.totals.netto) : '–' %></span><span class="stat-lbl">Netto totalt</span></div>
    <div class="stat"><span class="stat-val"><%= analysis.totals.count %></span><span class="stat-lbl">Overganger</span></div>
    <div class="stat"><span class="stat-val"><%= analysis.season && analysis.season.hitRate !== null ? Math.round(analysis.season.hitRate * 100) + ' %' : '–' %></span><span class="stat-lbl">Treffprosent</span></div>
    <div class="stat"><span class="stat-val"><%= analysis.totals.cost > 0 ? formatSigned(-analysis.totals.cost) : '0' %></span><span class="stat-lbl">Poengstraff<%= analysis.season && analysis.season.hitsPaid > 0 ? ' · ' + analysis.season.hitsPaid + ' trekk' : '' %></span></div>
    <div class="stat"><span class="stat-val"><%= analysis.bestIndex !== null ? analysis.rows[analysis.bestIndex].inn.name : '–' %></span><span class="stat-lbl">Beste bytte</span></div>
    <div class="stat"><span class="stat-val"><%= analysis.worstIndex !== null ? analysis.rows[analysis.worstIndex].inn.name : '–' %></span><span class="stat-lbl">Verste bytte</span></div>
  </div>

  <section class="card card-wide">
    <h2>Bytte for bytte</h2>
    <% if (analysis.totals.skipped > 0) { %>
      <p class="dim"><%= analysis.totals.skipped %> overganger kunne ikke tolkes fra FPL-dataene og er utelatt.</p>
    <% } %>
    <div class="table-scroll">
      <table class="data">
        <thead>
          <tr><th></th><th>Runde</th><th>Inn</th><th>Ut</th><th class="num">Poengdiff</th><th class="num">Straff</th><th class="num">Netto</th><th>Periode</th></tr>
        </thead>
        <tbody>
          <% for (let i = analysis.rows.length - 1; i >= 0; i--) { const r = analysis.rows[i]; const detaljer = r.perGw && r.perGw.length > 0; %>
            <tr>
              <td><% if (detaljer) { %><button type="button" class="btn-expand" aria-expanded="false" aria-label="Vis rundene for byttet"><span aria-hidden="true">+</span></button><% } %></td>
              <td><%= r.event %><% if (r.chip === 'wildcard') { %> <span class="status">Wildcard</span><% } else if (r.chip === 'freehit') { %> <span class="status">Free Hit</span><% } %></td>
              <td><%- include('partials/club-badge', { team: { short_name: r.inn.teamShort, code: r.inn.teamCode, name: r.inn.teamShort }, showName: false }) %> <%= r.inn.name %><% if (r.played) { %> <span class="dim"><%= r.inn.points %> p</span><% } %></td>
              <td><%- include('partials/club-badge', { team: { short_name: r.ut.teamShort, code: r.ut.teamCode, name: r.ut.teamShort }, showName: false }) %> <%= r.ut.name %><% if (r.played) { %> <span class="dim"><%= r.ut.points %> p</span><% } %></td>
              <td class="num"><%= r.played ? formatSigned(r.diff) : '–' %></td>
              <td class="num"><%= r.penaltyShare > 0 ? formatSigned(-r.penaltyShare) : '0' %></td>
              <td class="num <%= r.played && r.netto > 0 ? 'accent' : (r.played && r.netto < 0 ? 'negative' : '') %>">
                <%= r.played ? formatSigned(r.netto) : '–' %>
                <% if (i === analysis.bestIndex) { %> <span class="status status-best">Beste</span><% } %>
                <% if (i === analysis.worstIndex) { %> <span class="status status-worst">Verste</span><% } %>
              </td>
              <td class="dim"><% if (r.pending) { %>Venter på runde <%= r.event %><% } else if (!r.played) { %>Angret før deadline<% } else if (r.window.from === r.window.to) { %>R<%= r.window.from %><% } else { %>R<%= r.window.from %>–R<%= r.window.to %><% } %></td>
            </tr>
            <% if (detaljer) { %>
              <tr class="row-detail" hidden>
                <td colspan="8">
                  <% if (r.after5) { %>
                    <p class="milestone"><%
                      if (r.after5.complete && r.after5.gws === 5) { %>Etter 5 runder: <%= formatSigned(r.after5.diff) %><%
                      } else if (r.after5.complete) { %>Byttet varte <%= r.after5.gws %> runde<%= r.after5.gws === 1 ? '' : 'r' %>: <%= formatSigned(r.after5.diff) %><%
                      } else { %>Hittil (<%= r.after5.gws %> av 5 runder): <%= formatSigned(r.after5.diff) %><% } %></p>
                  <% } %>
                  <div class="table-scroll">
                    <table class="data">
                      <thead>
                        <tr><th>Runde</th><th class="num"><%= r.inn.name %></th><th class="num"><%= r.ut.name %></th><th class="num">Diff</th><th class="num">Sum</th></tr>
                      </thead>
                      <tbody>
                        <% for (const g of r.perGw) { %>
                          <tr>
                            <td>R<%= g.gw %></td>
                            <td class="num"><%= g.inn %></td>
                            <td class="num"><%= g.ut %></td>
                            <td class="num <%= g.diff > 0 ? 'accent' : (g.diff < 0 ? 'negative' : '') %>"><%= formatSigned(g.diff) %></td>
                            <td class="num"><%= formatSigned(g.cum) %></td>
                          </tr>
                        <% } %>
                      </tbody>
                    </table>
                  </div>
                </td>
              </tr>
            <% } %>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>

<section class="card card-wide" id="planlegger">
  <h2>Planlegger — hva hvis?</h2>
  <p class="dim">Prøv et bytte før du gjør det: velg hvem som skal ut og inn,
  se tallene side om side og få FPL-reglene sjekket — posisjon, budsjett
  (salgspris + bank) og maks 3 fra samme klubb. Ingenting sendes til FPL.</p>
  <div id="planner-root" data-endpoint="/api/planlegger.json">
    <button type="button" class="btn-link" id="planner-load">Åpne planleggeren</button>
  </div>
</section>

<% if (baseline) { %>
  <section class="card">
    <h2>Laget uten bytter</h2>
    <p>Hadde du latt GW1-laget stå urørt hele sesongen, ville det gitt
    <strong><%= baseline.simTotal %></strong> poeng. Du står med
    <strong><%= baseline.actualTotal !== null ? baseline.actualTotal : '–' %></strong><% if (baseline.diff !== null) { %> —
    byttene (med straff) har altså <%= baseline.diff >= 0 ? 'gitt deg' : 'kostet deg' %>
    <strong class="<%= baseline.diff > 0 ? 'accent' : (baseline.diff < 0 ? 'negative' : '') %>"><%= formatSigned(baseline.diff) %></strong> poeng<% } %>.</p>
    <details>
      <summary>Runde for runde</summary>
      <div class="table-scroll">
        <table class="data">
          <thead><tr><th>Runde</th><th class="num">Poeng</th><th>Kaptein</th><th class="num">Autosubs</th></tr></thead>
          <tbody>
            <% for (const g of baseline.perGw) { %>
              <tr>
                <td>R<%= g.gw %></td>
                <td class="num"><%= g.points %></td>
                <td><%= g.captainName ?? '–' %><%= g.viceUsed ? ' (vise)' : '' %></td>
                <td class="num"><%= g.autosubs.length %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </details>
    <p class="dim">Simulering: startere uten spilleminutter byttes automatisk
    mot benken i benkerekkefølge under formasjonskravene (keeper kun mot
    keeper). Kaptein er rundens faktiske kaptein når han står i GW1-laget,
    ellers visekapteinen; dobling er alltid ×2.</p>
  </section>
<% } %>

<% if (priceReport) { %>
  <section class="card card-wide">
    <h2>Prisgevinst</h2>
    <p class="dim">Kjøpspris mot dagens pris og salgspris — FPL gir deg halve
    prisstigningen, rundet ned. Lagverdi
    <%= priceReport.value !== null ? formatPrice(priceReport.value) : '–' %>
    · bank <%= priceReport.bank !== null ? formatPrice(priceReport.bank) : '–' %> (£m).</p>
    <div class="table-scroll">
      <table class="data">
        <thead>
          <tr><th>Spiller</th><th class="num">Kjøpt</th><th class="num">Nå</th><th class="num">Salg</th><th class="num">Gevinst</th></tr>
        </thead>
        <tbody>
          <% for (const h of priceReport.holdings) { %>
            <tr>
              <td><%- include('partials/club-badge', { team: { short_name: h.teamShort, code: h.teamCode, name: h.teamShort }, showName: false }) %> <%= h.name %></td>
              <% if (h.ukjent) { %>
                <td class="num dim" colspan="4">ukjent kjøpspris</td>
              <% } else { %>
                <td class="num"><%= formatPrice(h.buyCost) %></td>
                <td class="num"><%= formatPrice(h.nowCost) %></td>
                <td class="num"><%= formatPrice(h.sellPrice) %></td>
                <td class="num <%= h.gain > 0 ? 'accent' : (h.gain < 0 ? 'negative' : '') %>"><%= (h.gain > 0 ? '+' : '') + formatPrice(h.gain) %></td>
              <% } %>
            </tr>
          <% } %>
          <tr>
            <td><strong>Sum</strong></td>
            <td class="num"><strong><%= formatPrice(priceReport.totals.buyCost) %></strong></td>
            <td class="num"><strong><%= formatPrice(priceReport.totals.nowCost) %></strong></td>
            <td class="num"><strong><%= formatPrice(priceReport.totals.sellPrice) %></strong></td>
            <td class="num <%= priceReport.totals.gain > 0 ? 'accent' : (priceReport.totals.gain < 0 ? 'negative' : '') %>"><strong><%= (priceReport.totals.gain > 0 ? '+' : '') + formatPrice(priceReport.totals.gain) %></strong></td>
          </tr>
        </tbody>
      </table>
    </div>
    <% if (priceReport.missed.length > 0) { %>
      <h3>Salg du gikk glipp av</h3>
      <ul class="dim">
        <% for (const m of priceReport.missed.slice(0, 3)) { %>
          <li><%= m.name %>: solgt for <%= formatPrice(m.soldFor) %>, nå <%= formatPrice(m.nowCost) %> (gikk glipp av <%= formatPrice(m.missed) %>)</li>
        <% } %>
      </ul>
    <% } %>
  </section>
<% } %>
