<section class="page-head">
  <h1>Overganger</h1>
  <p class="dim">Hva byttene dine var verdt: poengene spilleren du hentet
  faktisk fikk, minus poengene spilleren du solgte fikk, så lenge byttet var
  i effekt — rå spillerpoeng uten benk- og kapteinsvekting, minus
  poengstraff. Hvert bytte måles for seg.</p>
</section>

<% if (typeof priceChanges !== 'undefined' && priceChanges) { %>
  <%# Prisvarsler (v1.10.0): samme innhold som Discord-meldingen (priceChangesText). %>
  <section class="card card-wide" id="prisendringer">
    <h2>
      <span class="h2-title">Prisendringer natt til <%= formatDay(priceChanges.date + 'T12:00:00') %></span>
      <span class="dim"><%= priceChanges.countUp %> opp · <%= priceChanges.countDown %> ned</span>
    </h2>
    <p class="hint">Sjekkes hver time; FPL endrer priser om natten. Troppen din først, så nattens største bevegelser.</p>
    <div class="grid">
      <div>
        <% if (priceChanges.mine.length === 0) { %>
          <p class="empty">Ingen endringer i troppen din.</p>
        <% } else { %>
          <h3 class="sub-head">Troppen din</h3>
          <div class="table-scroll">
            <table class="data data--fit">
              <caption class="sr-only">Prisendringer i troppen din</caption>
              <thead><tr><th scope="col">Spiller</th><th scope="col" class="num">Pris</th><th scope="col" class="num">Endring</th></tr></thead>
              <tbody>
                <% for (const r of priceChanges.mine) { %>
                  <tr>
                    <td><strong><%= r.name %></strong> <%- include('partials/club-badge', { team: { short_name: r.teamShort, code: r.teamCode } }) %></td>
                    <td class="num">£<%= formatPrice(r.from) %>m → £<%= formatPrice(r.to) %>m</td>
                    <td class="num <%= r.delta > 0 ? 'accent' : 'negative' %>"><%= formatSigned(r.delta / 10) %></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
      <% for (const [label, rows, total] of [['Opp', priceChanges.risers, priceChanges.countUp], ['Ned', priceChanges.fallers, priceChanges.countDown]]) { %>
        <div>
          <h3 class="sub-head"><%= label %> (<%= rows.length %> av <%= total %>)</h3>
          <% if (rows.length === 0) { %>
            <p class="empty">Ingen.</p>
          <% } else { %>
            <div class="table-scroll">
              <table class="data data--fit">
                <caption class="sr-only">Nattens største prisbevegelser <%= label.toLowerCase() %></caption>
                <thead><tr><th scope="col">Spiller</th><th scope="col" class="num">Pris</th><th scope="col" class="num">Endring</th></tr></thead>
                <tbody>
                  <% for (const r of rows) { %>
                    <tr>
                      <td><a href="/spillere?sok=<%= encodeURIComponent(r.name) %>"><%= r.name %></a> <%- include('partials/club-badge', { team: { short_name: r.teamShort, code: r.teamCode } }) %></td>
                      <td class="num">£<%= formatPrice(r.from) %>m → £<%= formatPrice(r.to) %>m</td>
                      <td class="num <%= r.delta > 0 ? 'accent' : 'negative' %>"><%= formatSigned(r.delta / 10) %></td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </section>
<% } %>

<% if (typeof priceForecast !== 'undefined' && priceForecast) {
  // Prisprognose (v1.14.0): FPLs egne, udokumenterte prognosefelt fra bootstrap.
  // pct er progresjon mot terskelen, ikke et løfte — fire spillere lå under
  // −100 uten å falle 4. sep 2026. likelihood er et heltall −5..+5.
  const sannsynlighet = (n) => {
    const v = Math.abs(n);
    if (v >= 4) return 'svært trolig';
    if (v === 3) return 'trolig';
    if (v >= 1) return 'mulig';
    return '–';
  };
%>
  <section class="card card-wide" id="prisprognose">
    <h2>
      <span class="h2-title">Prisprognose</span>
      <span class="dim"><%= priceForecast.countRising %> mot oppgang · <%= priceForecast.countFalling %> mot nedgang</span>
    </h2>
    <p class="hint">FPLs egne tall, oppdatert med bootstrap hvert kvarter. Prosenten er hvor nær
    en prisendring spilleren er — rundt 100 endrer prisen seg som regel i natt, men FPL garanterer
    ingenting. «Bytter/t» er netto overganger per time.</p>
    <div class="grid">
      <div>
        <h3 class="sub-head">Din tropp</h3>
        <% if (priceForecast.mine.length === 0) { %>
          <p class="empty">Ingen i troppen din er nær en prisendring.</p>
        <% } else { %>
          <div class="table-scroll">
            <table class="data data--fit">
              <caption class="sr-only">Prisprognose for troppen din</caption>
              <thead><tr><th scope="col">Spiller</th><th scope="col" class="num">Pris</th><th scope="col" class="num">Mot endring</th><th scope="col">FPL-sannsynlighet</th><th scope="col" class="num">Bytter/t</th></tr></thead>
              <tbody>
                <% for (const r of priceForecast.mine) { %>
                  <tr>
                    <td><strong><%= r.name %></strong> <%- include('partials/club-badge', { team: { short_name: r.teamShort, code: r.teamCode } }) %></td>
                    <td class="num">£<%= formatPrice(r.cost) %>m</td>
                    <td class="num <%= r.pct > 0 ? 'accent' : r.pct < 0 ? 'negative' : '' %>"><%= formatSigned(r.pct) %> %</td>
                    <td><% if (r.lockedUntil) { %><span class="dim">låst til <%= formatDay(r.lockedUntil) %> kl. <%= formatTime(r.lockedUntil) %></span><% } else { %><%= sannsynlighet(r.likelihood) %><% } %></td>
                    <td class="num"><%= formatSigned(r.rate) %></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
      <% for (const [label, rows, total] of [['Stiger', priceForecast.risers, priceForecast.countRising], ['Faller', priceForecast.fallers, priceForecast.countFalling]]) { %>
        <div>
          <h3 class="sub-head"><%= label %> (<%= rows.length %> av <%= total %>)</h3>
          <% if (rows.length === 0) { %>
            <p class="empty">Ingen.</p>
          <% } else { %>
            <div class="table-scroll">
              <table class="data data--fit">
                <caption class="sr-only">Markedet nærmest en prisendring — <%= label.toLowerCase() %></caption>
                <thead><tr><th scope="col">Spiller</th><th scope="col" class="num">Pris</th><th scope="col" class="num">Mot endring</th><th scope="col">FPL-sannsynlighet</th><th scope="col" class="num">Bytter/t</th></tr></thead>
                <tbody>
                  <% for (const r of rows) { %>
                    <tr>
                      <td><a href="/spillere?sok=<%= encodeURIComponent(r.name) %>"><%= r.name %></a> <%- include('partials/club-badge', { team: { short_name: r.teamShort, code: r.teamCode } }) %></td>
                      <td class="num">£<%= formatPrice(r.cost) %>m</td>
                      <td class="num <%= r.pct > 0 ? 'accent' : 'negative' %>"><%= formatSigned(r.pct) %> %</td>
                      <td><%= sannsynlighet(r.likelihood) %></td>
                      <td class="num"><%= formatSigned(r.rate) %></td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </section>
<% } %>

<% if (analysis.totals.count === 0) { %>
  <section class="card">
    <p class="empty">
      Ingen overganger registrert ennå. Din første overgang kan tidligst
      gjelde runde 2 — når du bytter en spiller, dukker regnskapet opp her:
      poeng inn mot poeng ut for hvert bytte, straff, og summen for sesongen.
    </p>
  </section>
<% } else { %>
  <% const played = analysis.rows.filter((r) => r.played); %>
  <div class="stat-strip">
    <div class="stat"><span class="stat-val <%= analysis.totals.netto > 0 ? 'accent' : (analysis.totals.netto < 0 ? 'negative' : '') %>"><%= played.length ? formatSigned(analysis.totals.netto) : '–' %></span><span class="stat-lbl">Netto totalt</span></div>
    <div class="stat"><span class="stat-val"><%= analysis.totals.count %></span><span class="stat-lbl">Overganger</span></div>
    <div class="stat"><span class="stat-val"><%= analysis.season && analysis.season.hitRate !== null ? Math.round(analysis.season.hitRate * 100) + ' %' : '–' %></span><span class="stat-lbl">Treffprosent</span></div>
    <div class="stat"><span class="stat-val"><%= analysis.totals.cost > 0 ? formatSigned(-analysis.totals.cost) : '0' %></span><span class="stat-lbl">Poengstraff<%= analysis.season && analysis.season.hitsPaid > 0 ? ' · ' + analysis.season.hitsPaid + ' trekk' : '' %></span></div>
    <div class="stat"><span class="stat-val"><%= analysis.bestIndex !== null ? analysis.rows[analysis.bestIndex].inn.name : '–' %></span><span class="stat-lbl">Beste bytte</span></div>
    <div class="stat"><span class="stat-val"><%= analysis.worstIndex !== null ? analysis.rows[analysis.worstIndex].inn.name : '–' %></span><span class="stat-lbl">Verste bytte</span></div>
  </div>

  <% if (aiComment && aiComment.text) { %>
    <%
      // AI-tekst er utrygt innhold: escape først, gjør **fet** om til <strong>.
      function escAi(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }
      function boldAi(text) {
        return escAi(text).replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      }
    %>
    <section class="card card-wide card-ai">
      <h2><span class="h2-title"><span class="ai-badge">AI</span> Kommentar til byttene</span></h2>
      <% for (const line of aiComment.text.split('\n').filter((l) => l.trim())) { %>
        <p><%- boldAi(line) %></p>
      <% } %>
    </section>
  <% } %>

  <section class="card card-wide">
    <h2>Bytte for bytte</h2>
    <% if (analysis.totals.skipped > 0) { %>
      <p class="dim"><%= analysis.totals.skipped %> overganger kunne ikke tolkes fra FPL-dataene og er utelatt.</p>
    <% } %>
    <div class="table-scroll">
      <table class="data"><caption class="sr-only">Bytte for bytte</caption>
        <thead>
          <tr><th></th><th>Runde</th><th>Inn</th><th>Ut</th><th class="num">Poengdiff</th><th class="num">Straff</th><th class="num">Netto</th><th>Periode</th></tr>
        </thead>
        <tbody>
          <% for (let i = analysis.rows.length - 1; i >= 0; i--) { const r = analysis.rows[i]; const detaljer = r.perGw && r.perGw.length > 0; %>
            <tr<%- r.pending || !r.played ? ' class="row-muted"' : '' %>>
              <td><% if (detaljer) { %><button type="button" class="btn-expand" aria-expanded="false" aria-label="Vis rundene for byttet"><span aria-hidden="true">+</span></button><% } %></td>
              <td><%= r.event %><% if (r.chip === 'wildcard') { %> <span class="status">Wildcard</span><% } else if (r.chip === 'freehit') { %> <span class="status">Free Hit</span><% } %></td>
              <td><%- include('partials/club-badge', { team: { short_name: r.inn.teamShort, code: r.inn.teamCode, name: r.inn.teamShort }, showName: false }) %> <%= r.inn.name %><% if (r.played) { %> <span class="dim"><%= r.inn.points %> p</span><% } %></td>
              <td><%- include('partials/club-badge', { team: { short_name: r.ut.teamShort, code: r.ut.teamCode, name: r.ut.teamShort }, showName: false }) %> <%= r.ut.name %><% if (r.played) { %> <span class="dim"><%= r.ut.points %> p</span><% } %></td>
              <td class="num"><%= r.played ? formatSigned(r.diff) : '–' %></td>
              <td class="num"><%= r.penaltyShare > 0 ? formatSigned(-r.penaltyShare) : '0' %></td>
              <td class="num <%= r.played && r.netto > 0 ? 'accent' : (r.played && r.netto < 0 ? 'negative' : '') %>">
                <%= r.played ? formatSigned(r.netto) : '–' %>
                <% if (i === analysis.bestIndex) { %> <span class="status status-best">Beste</span><% } %>
                <% if (i === analysis.worstIndex) { %> <span class="status status-worst">Verste</span><% } %>
              </td>
              <td class="dim"><% if (r.pending) { %><span class="status">Venter på runde <%= r.event %></span><% } else if (!r.played) { %><span class="status">Angret før deadline</span><% } else if (r.window.from === r.window.to) { %>R<%= r.window.from %><% } else { %>R<%= r.window.from %>–R<%= r.window.to %><% } %></td>
            </tr>
            <% if (detaljer) { %>
              <tr class="row-detail" hidden>
                <td colspan="8">
                  <% if (r.after5) { %>
                    <p class="milestone"><%
                      if (r.after5.complete && r.after5.gws === 5) { %>Etter 5 runder: <%= formatSigned(r.after5.diff) %><%
                      } else if (r.after5.complete) { %>Byttet varte <%= r.after5.gws %> runde<%= r.after5.gws === 1 ? '' : 'r' %>: <%= formatSigned(r.after5.diff) %><%
                      } else { %>Hittil (<%= r.after5.gws %> av 5 runder): <%= formatSigned(r.after5.diff) %><% } %></p>
                  <% } %>
                  <div class="table-scroll">
                    <table class="data"><caption class="sr-only">Rundene for byttet <%= r.ut.name %> mot <%= r.inn.name %></caption>
                      <thead>
                        <tr><th>Runde</th><th class="num"><%= r.inn.name %></th><th class="num"><%= r.ut.name %></th><th class="num">Diff</th><th class="num">Sum</th></tr>
                      </thead>
                      <tbody>
                        <% for (const g of r.perGw) { %>
                          <tr>
                            <td>R<%= g.gw %></td>
                            <td class="num"><%= g.inn %></td>
                            <td class="num"><%= g.ut %></td>
                            <td class="num <%= g.diff > 0 ? 'accent' : (g.diff < 0 ? 'negative' : '') %>"><%= formatSigned(g.diff) %></td>
                            <td class="num"><%= formatSigned(g.cum) %></td>
                          </tr>
                        <% } %>
                      </tbody>
                    </table>
                  </div>
                  <% if (r.alternativer && r.alternativer.length > 0) { %>
                    <p class="milestone">I stedet for <%= r.inn.name %> — samme posisjon og prisklasse (pris ved sesongstart), målt i samme vindu:</p>
                    <ul class="scenario-moves dim">
                      <% for (const alt of r.alternativer) { %>
                        <li><%- include('partials/club-badge', { team: { short_name: alt.teamShort, code: alt.teamCode, name: alt.teamShort }, showName: false }) %> <%= alt.name %> — <%= alt.points %> p (<%= formatSigned(alt.delta) %> mot ditt valg)</li>
                      <% } %>
                    </ul>
                  <% } %>
                  <div class="alt-egen" data-fra="<%= r.window.from %>" data-til="<%= r.window.to %>" data-innpoints="<%= r.inn.points %>">
                    <input type="search" class="alt-sok" placeholder="Sjekk en hvilken som helst spiller i samme vindu …" autocomplete="off" aria-label="Søk etter kandidat">
                    <ul class="planner-hits alt-hits"></ul>
                    <ul class="scenario-moves dim alt-resultater"></ul>
                  </div>
                </td>
              </tr>
            <% } %>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>

<section class="card card-wide" id="planlegger">
  <h2>Planlegger — hva hvis?</h2>
  <p class="dim">Prøv et bytte før du gjør det: velg hvem som skal ut og inn,
  se tallene side om side og få FPL-reglene sjekket — posisjon, budsjett
  (salgspris + bank) og maks 3 fra samme klubb. Ingenting sendes til FPL.</p>
  <div id="planner-root" data-endpoint="/api/planlegger.json">
    <button type="button" class="btn-link" id="planner-load">Åpne planleggeren</button>
  </div>
</section>

<% if (scenarios && scenarios.length > 0) { %>
  <section class="card card-wide" id="scenarier">
    <h2>Scenarier</h2>
    <p class="dim">Planene dine, målt mot det du faktisk gjorde. En plan antas
    å erstatte rundens faktiske bytter og beholdes ut sesongen; trekk regnes
    fra gratisbytte-beholdningen din når den kan rekonstrueres sikkert.</p>
    <% for (const s of scenarios) { const ev = s.evaluering; %>
      <div class="scenario">
        <div class="scenario-head">
          <strong><%= s.name %></strong> <span class="dim">· runde <%= s.event %></span>
          <button type="button" class="btn-delete" data-scenario-delete="<%= s.id %>">Slett</button>
        </div>
        <ul class="scenario-moves dim">
          <% for (const m of ev.perMove) { %>
            <li><%= m.out.name %> → <%= m.in.name %><% if (m.diff !== null) { %> (<%= formatSigned(m.diff) %>)<% } %></li>
          <% } %>
        </ul>
        <% if (ev.pending) { %>
          <p class="dim">Venter på runde <%= s.event %><% if (ev.plan.cost !== null) { %> · forventet trekk: <%= ev.plan.cost > 0 ? formatSigned(-ev.plan.cost) : '0' %><% } %></p>
        <% } else { %>
          <% const planNetto = ev.plan.diff - (ev.plan.cost ?? 0); const faktiskNetto = ev.actual.diff - ev.actual.cost; %>
          <p>
            Planen ville gitt
            <strong class="<%= planNetto > 0 ? 'accent' : (planNetto < 0 ? 'negative' : '') %>"><%= formatSigned(planNetto) %></strong><%
            if (ev.plan.cost === null) { %> <span class="dim">(uten trekk — kunne ikke beregnes sikkert)</span><%
            } else if (ev.plan.cost > 0) { %> <span class="dim">(<%= formatSigned(ev.plan.diff) %> minus <%= ev.plan.cost %> i trekk)</span><% } %>
            — du fikk
            <strong class="<%= faktiskNetto > 0 ? 'accent' : (faktiskNetto < 0 ? 'negative' : '') %>"><%= formatSigned(faktiskNetto) %></strong><%
            if (ev.actual.cost > 0) { %> <span class="dim">(<%= formatSigned(ev.actual.diff) %> minus <%= ev.actual.cost %> i trekk)</span><% } %>.
          </p>
          <% if (ev.plan.after5) { %>
            <p class="milestone">Etter <%= ev.plan.after5.gws %> av 5 runder: planen <%= formatSigned(ev.plan.after5.diff) %><% if (ev.actual.after5) { %> · faktisk <%= formatSigned(ev.actual.after5.diff) %><% } %></p>
          <% } %>
        <% } %>
      </div>
    <% } %>
  </section>
<% } %>

<% if (baseline) { %>
  <section class="card">
    <h2>Laget uten bytter</h2>
    <p>Hadde du latt GW1-laget stå urørt hele sesongen, ville det gitt
    <strong><%= baseline.simTotal %></strong> poeng. Du står med
    <strong><%= baseline.actualTotal !== null ? baseline.actualTotal : '–' %></strong><% if (baseline.diff !== null) { %> —
    byttene (med straff) har altså <%= baseline.diff >= 0 ? 'gitt deg' : 'kostet deg' %>
    <strong class="<%= baseline.diff > 0 ? 'accent' : (baseline.diff < 0 ? 'negative' : '') %>"><%= formatSigned(baseline.diff) %></strong> poeng<% } %>.</p>
    <details>
      <summary>Runde for runde</summary>
      <div class="table-scroll">
        <table class="data"><caption class="sr-only">Laget uten bytter per runde</caption>
          <thead><tr><th>Runde</th><th class="num">Poeng</th><th>Kaptein</th><th class="num">Autosubs</th></tr></thead>
          <tbody>
            <% for (const g of baseline.perGw) { %>
              <tr>
                <td>R<%= g.gw %></td>
                <td class="num"><%= g.points %></td>
                <td><%= g.captainName ?? '–' %><%= g.viceUsed ? ' (vise)' : '' %></td>
                <td class="num"><%= g.autosubs.length %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </details>
    <p class="dim">Simulering: startere uten spilleminutter byttes automatisk
    mot benken i benkerekkefølge under formasjonskravene (keeper kun mot
    keeper). Kaptein er rundens faktiske kaptein når han står i GW1-laget,
    ellers visekapteinen; dobling er alltid ×2.</p>
  </section>
<% } %>

<% if (priceReport) { %>
  <section class="card card-wide">
    <h2>Prisgevinst</h2>
    <p class="dim">Kjøpspris mot dagens pris og salgspris — FPL gir deg halve
    prisstigningen, rundet ned. Lagverdi
    <%= priceReport.value !== null ? formatPrice(priceReport.value) : '–' %>
    · bank <%= priceReport.bank !== null ? formatPrice(priceReport.bank) : '–' %> (£m).</p>
    <div class="table-scroll">
      <table class="data"><caption class="sr-only">Prisgevinst per spiller</caption>
        <thead>
          <%# «Nå» skjules under 480 px (.col-now) — fem kolonner sprengte 390 px
              og dyttet «Gevinst» ut. Ingen colspan får krysse den kolonna. %>
          <tr><th>Spiller</th><th class="num">Kjøpt</th><th class="num col-now">Nå</th><th class="num">Salg</th><th class="num">Gevinst</th></tr>
        </thead>
        <tbody>
          <% for (const h of priceReport.holdings) { %>
            <tr>
              <td><%- include('partials/club-badge', { team: { short_name: h.teamShort, code: h.teamCode, name: h.teamShort }, showName: false }) %> <%= h.name %></td>
              <% if (h.ukjent) { %>
                <%# Egne celler i stedet for colspan=4: en colspan tvers over
                    «Nå» ville kreve én kolonne mer enn de andre radene når
                    kolonna er skjult, og skape en tom fantomkolonne. Kolonnen
                    Salg+Gevinst ligger etter «Nå» og kan trygt slås sammen. %>
                <td class="dim">ukjent</td>
                <td class="num dim col-now"><%= h.nowCost === null ? '–' : formatPrice(h.nowCost) %></td>
                <td class="num dim" colspan="2">–</td>
              <% } else { %>
                <td class="num"><%= formatPrice(h.buyCost) %></td>
                <td class="num col-now"><%= formatPrice(h.nowCost) %></td>
                <td class="num"><%= formatPrice(h.sellPrice) %></td>
                <td class="num <%= h.gain > 0 ? 'accent' : (h.gain < 0 ? 'negative' : '') %>"><%= formatSigned(h.gain / 10) %></td>
              <% } %>
            </tr>
          <% } %>
          <tr>
            <td><strong>Sum</strong></td>
            <td class="num"><strong><%= formatPrice(priceReport.totals.buyCost) %></strong></td>
            <td class="num col-now"><strong><%= formatPrice(priceReport.totals.nowCost) %></strong></td>
            <td class="num"><strong><%= formatPrice(priceReport.totals.sellPrice) %></strong></td>
            <td class="num <%= priceReport.totals.gain > 0 ? 'accent' : (priceReport.totals.gain < 0 ? 'negative' : '') %>"><strong><%= formatSigned(priceReport.totals.gain / 10) %></strong></td>
          </tr>
        </tbody>
      </table>
    </div>
    <% if (priceReport.missed.length > 0) { %>
      <h3>Salg du gikk glipp av</h3>
      <ul class="dim">
        <% for (const m of priceReport.missed.slice(0, 3)) { %>
          <li><%= m.name %>: solgt for <%= formatPrice(m.soldFor) %>, nå <%= formatPrice(m.nowCost) %> (gikk glipp av <%= formatPrice(m.missed) %>)</li>
        <% } %>
      </ul>
    <% } %>
  </section>
<% } %>
