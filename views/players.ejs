<section class="page-head">
  <h1>Spillere</h1>
  <p class="dim">Klikk på et spillernavn for spillerkortet.
  <span title="Forventede mål og målgivende for sesongen, fra FPL">xG/xA</span>
  er FPLs forventede tall for sesongen.</p>
  <div class="fane-rad" role="tablist" aria-label="Seksjoner på siden">
    <button type="button" class="fane-knapp" role="tab" id="fane-tabell" data-fane="tabell" aria-controls="tabell" aria-selected="true">Tabell</button>
    <button type="button" class="fane-knapp" role="tab" id="fane-differensialer" data-fane="differensialer" aria-controls="differensialer" aria-selected="false" tabindex="-1">Differensialer</button>
    <button type="button" class="fane-knapp" role="tab" id="fane-dodballtakere" data-fane="dodballtakere" aria-controls="dodballtakere" aria-selected="false" tabindex="-1">Dødballtakere</button>
  </div>
</section>

<form class="filters" id="player-filters" onsubmit="return false">
  <label>
    Søk
    <input type="search" id="filter-search" placeholder="Spillernavn …" autocomplete="off">
  </label>
  <label>
    Posisjon
    <select id="filter-position">
      <option value="">Alle</option>
      <% for (const [id, name] of Object.entries(POSITIONS)) { %>
        <option value="<%= id %>"><%= name %></option>
      <% } %>
    </select>
  </label>
  <label>
    Lag
    <select id="filter-team">
      <option value="">Alle</option>
      <% for (const t of teams) { %>
        <option value="<%= t.id %>"><%= t.name %></option>
      <% } %>
    </select>
  </label>
  <label>
    Maks pris
    <input type="number" id="filter-price" min="3.5" max="16" step="0.1" placeholder="f.eks. 8.0">
  </label>
  <label>
    Status
    <select id="filter-status">
      <option value="">Alle</option>
      <% for (const [code, label] of Object.entries(STATUS_LABELS)) { %>
        <option value="<%= code %>"><%= label %></option>
      <% } %>
    </select>
  </label>
  <button type="button" id="filter-reset">Nullstill</button>
  <span class="dim" id="filter-count" role="status"></span>
</form>

<section class="card" id="tabell" role="tabpanel" aria-labelledby="fane-tabell">
  <div class="duell-bar">
    <span class="dim" id="duell-teller" role="status">0 av 2 valgt</span>
    <button type="button" class="btn-accent" id="duell-start" disabled>Sammenlign</button>
    <button type="button" class="btn-quiet" id="duell-tom">Tøm valg</button>
  </div>
  <div class="table-scroll table-scroll--pinned">
    <table class="data sortable" id="players-table" data-sortable>
      <thead>
        <tr>
          <th data-nosort>Duell</th>
          <th data-type="text" aria-sort="none">Spiller</th>
          <th data-type="text" aria-sort="none">Lag</th>
          <th data-type="text" aria-sort="none">Pos</th>
          <th data-type="num" class="num" aria-sort="none">Pris</th>
          <th data-type="num" class="num" aria-sort="none">Form</th>
          <th data-type="num" class="num" aria-sort="descending">Poeng</th>
          <th data-type="num" class="num" aria-sort="none" title="Poeng per kamp">P/K</th>
          <th data-type="num" class="num" aria-sort="none">Eid&nbsp;%</th>
          <th data-type="num" class="num" aria-sort="none">xG</th>
          <th data-type="num" class="num" aria-sort="none">xA</th>
          <th data-type="text" aria-sort="none">Status</th>
        </tr>
      </thead>
      <tbody>
        <% for (const p of players) { %>
          <tr
            data-name="<%= p.web_name.toLowerCase() %>"
            data-pos="<%= p.element_type %>"
            data-team="<%= p.team %>"
            data-price="<%= p.now_cost / 10 %>"
            data-status="<%= p.status %>"
            data-id="<%= p.id %>"
            data-navn="<%= p.web_name %>"
            data-lag="<%= (teamsById.get(p.team) || {}).short_name || '' %>"
            data-form="<%= p.form %>"
            data-poeng="<%= p.total_points %>"
            data-pk="<%= p.points_per_game %>"
            data-eid="<%= p.selected_by_percent %>"
            data-xg="<%= p.expected_goals %>"
            data-xa="<%= p.expected_assists %>"
            data-min="<%= p.minutes %>"
            data-bonus="<%= p.bonus %>"
            data-straffer="<%= p.penalties_order == null ? '' : p.penalties_order %>"
            data-hjorner="<%= p.corners_and_indirect_freekicks_order == null ? '' : p.corners_and_indirect_freekicks_order %>"
            data-frispark="<%= p.direct_freekicks_order == null ? '' : p.direct_freekicks_order %>"
          >
            <td><input type="checkbox" class="duell-velg" aria-label="Velg <%= p.web_name %> til duell"></td>
            <td><button type="button" class="navn-lenke js-spillerkort" data-id="<%= p.id %>"><%= p.web_name %></button></td>
            <td><%- include('partials/club-badge', { team: teamsById.get(p.team) }) %></td>
            <td><%= POSITIONS_SHORT[p.element_type] %></td>
            <td class="num"><%= formatPrice(p.now_cost) %></td>
            <td class="num"><%= p.form %></td>
            <td class="num"><strong><%= p.total_points %></strong></td>
            <td class="num"><%= p.points_per_game %></td>
            <td class="num"><%= p.selected_by_percent %></td>
            <td class="num"><%= p.expected_goals %></td>
            <td class="num"><%= p.expected_assists %></td>
            <td><% if (p.status !== 'a') { %><span class="status status-<%= p.status %>"><%= STATUS_LABELS[p.status] ?? p.status %></span><% } %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <p class="empty" id="players-empty" hidden>Ingen spillere matcher filtrene.
    <button type="button" class="btn-link" id="players-empty-reset">Nullstill filtrene</button></p>

  <%# Duellen hører til tabellen og bor derfor i samme fane — da følger den
      fanens synlighet uten egen logikk. %>
  <section id="duell" class="duell-panel" hidden></section>
</section>

<section class="card" id="differensialer" role="tabpanel" aria-labelledby="fane-differensialer" hidden>
  <h2>Differensialer</h2>
  <p class="dim">Spillere få eier globalt, rangert etter form og kampprogram:
  score = form × (6 − snitt-FDR de neste tre rundene). Høy score betyr god form
  mot et snilt program.</p>
  <% if (!differentials) { %>
    <p class="empty">Differensialer kommer når formtallene finnes — etter første runde.</p>
  <% } else { %>
    <fieldset class="terskel-velger">
      <legend>Maks global eierandel</legend>
      <div class="terskel-segmenter">
        <% for (const t of differentials.terskler) { %>
          <label><input type="radio" name="diff-terskel" value="<%= t.prosent %>"<%= t.prosent === 10 ? ' checked' : '' %>><span>under <%= t.prosent %>&nbsp;%</span></label>
        <% } %>
      </div>
    </fieldset>
    <% for (const t of differentials.terskler) { %>
      <div class="table-scroll" data-terskel="<%= t.prosent %>"<%= t.prosent === 10 ? '' : ' hidden' %>>
        <% if (t.rows.length === 0) { %>
          <p class="empty">Ingen spillere under <%= t.prosent %>&nbsp;% har form akkurat nå.</p>
        <% } else { %>
          <table class="data">
            <thead>
              <tr>
                <th>Spiller</th>
                <th>Lag</th>
                <th>Pos</th>
                <th class="num">Pris</th>
                <th class="num">Form</th>
                <th class="num">Eid&nbsp;%</th>
                <th class="num" title="Snitt-FDR de neste tre rundene">FDR&nbsp;3</th>
                <th class="num">Score</th>
              </tr>
            </thead>
            <tbody>
              <% for (const r of t.rows) { %>
                <tr>
                  <td><button type="button" class="navn-lenke js-spillerkort" data-id="<%= r.id %>"><%= r.navn %></button></td>
                  <td><%- include('partials/club-badge', { team: r.lag && { code: r.lag.kode, short_name: r.lag.kort, name: r.lag.navn } }) %></td>
                  <td><%= r.posKort %></td>
                  <td class="num"><%= r.pris %></td>
                  <td class="num"><%= r.form %></td>
                  <td class="num"><%= r.eid %></td>
                  <td class="num"><%= r.fdr3 %></td>
                  <td class="num score-celle" style="--andel: <%= r.andel %>%"><strong><%= r.score %></strong></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        <% } %>
      </div>
    <% } %>
  <% } %>
</section>

<section class="card" id="dodballtakere" role="tabpanel" aria-labelledby="fane-dodballtakere" hidden>
  <h2>Dødballtakere</h2>
  <p class="dim">De to første i køen per klubb, hentet fra FPLs egne ordenstall.
  «–» betyr at FPL ikke har oppgitt noen taker for rollen.</p>
  <div class="dodball-grid">
    <% for (const rad of setPieces) { %>
      <article class="dodball-kort">
        <div class="dodball-klubb"><%- include('partials/club-badge', { team: { code: rad.lag.kode, short_name: rad.lag.kort, name: rad.lag.navn } }) %></div>
        <dl class="dodball-roller">
          <% for (const [rolle, etikett] of [['straffer', 'Straffer'], ['hjorner', 'Hjørner/indirekte'], ['frispark', 'Direkte frispark']]) { %>
            <dt class="dodball-rolle"><%= etikett %></dt>
            <dd class="dodball-takere"><% if (rad[rolle].length === 0) { %>–<% } else { %><% rad[rolle].forEach((t, i) => { %><% if (i > 0) { %> · <% } %><%= i + 1 %>. <button type="button" class="navn-lenke js-spillerkort" data-id="<%= t.id %>"><%= t.navn %></button><% }) %><% } %></dd>
          <% } %>
        </dl>
      </article>
    <% } %>
  </div>
</section>

<%# Draktene rendres server-side av clubAssets-vokteren og klones av klienten.
    Modalen skriver derfor aldri en <img> for en fil som ikke finnes. %>
<% for (const t of teams) { %>
<template data-shirt="<%= t.id %>"><%- include('partials/club-shirt', { team: t, keeper: false }) %></template>
<template data-shirt-keeper="<%= t.id %>"><%- include('partials/club-shirt', { team: t, keeper: true }) %></template>
<% } %>

<div id="spillerkort" class="modal" hidden>
  <div class="modal-backdrop" data-modal-close></div>
  <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="spillerkort-tittel">
    <div class="modal-head">
      <h2 id="spillerkort-tittel">Spillerkort</h2>
      <button type="button" class="modal-close" id="spillerkort-lukk" aria-label="Lukk spillerkortet">×</button>
    </div>
    <div class="modal-body" id="spillerkort-body" aria-live="polite"></div>
  </div>
</div>
