<section class="page-head">
  <h1>Spillere</h1>
  <p class="dim">Klikk på en kolonne for å sortere. Filtrene virker uten sidelasting.
  xG/xA er FPLs forventede mål og målgivende for sesongen.</p>
</section>

<form class="filters" id="player-filters" onsubmit="return false">
  <label>
    Søk
    <input type="search" id="filter-search" placeholder="Spillernavn …" autocomplete="off">
  </label>
  <label>
    Posisjon
    <select id="filter-position">
      <option value="">Alle</option>
      <% for (const [id, name] of Object.entries(POSITIONS)) { %>
        <option value="<%= id %>"><%= name %></option>
      <% } %>
    </select>
  </label>
  <label>
    Lag
    <select id="filter-team">
      <option value="">Alle</option>
      <% for (const t of teams) { %>
        <option value="<%= t.id %>"><%= t.name %></option>
      <% } %>
    </select>
  </label>
  <label>
    Maks pris
    <input type="number" id="filter-price" min="3.5" max="16" step="0.1" placeholder="f.eks. 8.0">
  </label>
  <label>
    Status
    <select id="filter-status">
      <option value="">Alle</option>
      <% for (const [code, label] of Object.entries(STATUS_LABELS)) { %>
        <option value="<%= code %>"><%= label %></option>
      <% } %>
    </select>
  </label>
  <button type="button" id="filter-reset">Nullstill</button>
  <span class="dim" id="filter-count" role="status"></span>
</form>

<section class="card">
  <div class="table-scroll table-scroll--pinned">
    <table class="data sortable" id="players-table" data-sortable>
      <thead>
        <tr>
          <th data-type="text" aria-sort="none">Spiller</th>
          <th data-type="text" aria-sort="none">Lag</th>
          <th data-type="text" aria-sort="none">Pos</th>
          <th data-type="num" class="num" aria-sort="none">Pris</th>
          <th data-type="num" class="num" aria-sort="none">Form</th>
          <th data-type="num" class="num" aria-sort="descending">Poeng</th>
          <th data-type="num" class="num" aria-sort="none" title="Poeng per kamp">P/K</th>
          <th data-type="num" class="num" aria-sort="none">Eid&nbsp;%</th>
          <th data-type="num" class="num" aria-sort="none">xG</th>
          <th data-type="num" class="num" aria-sort="none">xA</th>
          <th data-type="text" aria-sort="none">Status</th>
        </tr>
      </thead>
      <tbody>
        <% for (const p of players) { %>
          <tr
            data-name="<%= p.web_name.toLowerCase() %>"
            data-pos="<%= p.element_type %>"
            data-team="<%= p.team %>"
            data-price="<%= p.now_cost / 10 %>"
            data-status="<%= p.status %>"
          >
            <td><strong><%= p.web_name %></strong></td>
            <td><%- include('partials/club-badge', { team: teamsById.get(p.team) }) %></td>
            <td><%= POSITIONS_SHORT[p.element_type] %></td>
            <td class="num"><%= formatPrice(p.now_cost) %></td>
            <td class="num"><%= p.form %></td>
            <td class="num"><strong><%= p.total_points %></strong></td>
            <td class="num"><%= p.points_per_game %></td>
            <td class="num"><%= p.selected_by_percent %></td>
            <td class="num"><%= p.expected_goals %></td>
            <td class="num"><%= p.expected_assists %></td>
            <td><span class="status status-<%= p.status %>"><%= STATUS_LABELS[p.status] ?? p.status %></span></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <p class="empty" id="players-empty" hidden>Ingen spillere matcher filtrene.
    <button type="button" class="btn-link" id="players-empty-reset">Nullstill filtrene</button></p>
</section>
